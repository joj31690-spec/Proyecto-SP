# .env.example — Plantilla de configuración compartida
# Copiar a .env y reemplazar por tus valores reales.
# NUNCA subir el archivo .env real al repositorio.

# Servidor y aplicación
PORT=5000
NODE_ENV=development
JWT_SECRET=reemplazar_por_una_clave_secreta
JWT_EXPIRES_IN=8h

# URLs de la aplicación
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000/api

# Base de datos PostgreSQL (también usada por docker-compose.yml)
DATABASE_URL=postgresql://admin_syslab:cambiar_contraseña@postgres-db:5432/syslab_db?schema=public
POSTGRES_USER=admin_syslab
POSTGRES_PASSWORD=cambiar_contraseña
POSTGRES_DB=syslab_db