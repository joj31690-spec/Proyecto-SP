// backend/prisma/schema.prisma
// ============================================================
// Personal Finance Manager — Modelo de persistencia (Prisma ORM)
// Proveedor: PostgreSQL (SysLab 2.0)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Usuario — identificador principal de la información financiera
// ============================================================
model Usuario {
  id            Int        @id @default(autoincrement())
  nombre        String     @db.VarChar(100)
  email         String     @unique @db.VarChar(150)
  passwordHash  String     @map("password_hash") @db.VarChar(255)
  activo        Boolean    @default(true)
  creadoEn      DateTime   @default(now()) @map("creado_en")
  actualizadoEn DateTime   @updatedAt @map("actualizado_en")

  movimientos  Movimiento[]
  categorias   Categoria[]
  metas        MetaAhorro[]
  recurrentes  GastoRecurrente[]

  @@map("usuarios")
}

// ============================================================
// Categoria — clasificación de los movimientos financieros
// ============================================================
model Categoria {
  id       Int    @id @default(autoincrement())
  nombre   String @db.VarChar(80)
  color    String @default("#3b82f6") @db.VarChar(9)
  tipo     String @default("gasto") @db.VarChar(20) // 'ingreso' | 'gasto'
  usuarioId Int  @map("usuario_id")

  usuario      Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  movimientos  Movimiento[]
  presupuestos Presupuesto[]
  recurrentes GastoRecurrente[]

  @@unique([usuarioId, nombre])
  @@map("categorias")
}

// ============================================================
// Movimiento — ingreso o gasto financiero registrado por el usuario
// ============================================================
model Movimiento {
  id            Int      @id @default(autoincrement())
  tipo          String   @db.VarChar(20) // 'ingreso' | 'gasto'
  monto         Decimal  @db.Decimal(12, 2)
  descripcion   String?  @db.VarChar(255)
  fecha         DateTime @default(now())
  metodoPago    String?  @map("metodo_pago") @db.VarChar(50)
  usuarioId     Int      @map("usuario_id")
  categoriaId   Int      @map("categoria_id")
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  categoria Categoria @relation(fields: [categoriaId], references: [id])
  recurrenteId Int? @map("recurrente_id")
  fechaProgramada DateTime? @db.Date @map("fecha_programada")
  recurrente GastoRecurrente? @relation(fields: [recurrenteId], references: [id], onDelete: SetNull)

  @@unique([recurrenteId, fechaProgramada])
  @@index([usuarioId, fecha])
  @@map("movimientos")
}

// ============================================================
// Presupuesto — límite de gasto mensual definido por categoría
// ============================================================
model Presupuesto {
  id            Int      @id @default(autoincrement())
  monto         Decimal  @db.Decimal(12, 2)
  anio          Int
  mes           Int // 1..12
  categoriaId   Int      @map("categoria_id")
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  categoria Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@unique([categoriaId, anio, mes])
  @@map("presupuestos")
}

model MetaAhorro {
  id Int @id @default(autoincrement())
  nombre String @db.VarChar(100)
  objetivo Decimal @db.Decimal(12, 2)
  fechaObjetivo DateTime? @db.Date @map("fecha_objetivo")
  usuarioId Int @map("usuario_id")
  creadoEn DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  aportes AporteAhorro[]

  @@index([usuarioId])
  @@map("metas_ahorro")
}

model AporteAhorro {
  id Int @id @default(autoincrement())
  monto Decimal @db.Decimal(12, 2)
  fecha DateTime @db.Date
  nota String? @db.VarChar(255)
  metaId Int @map("meta_id")
  creadoEn DateTime @default(now()) @map("creado_en")
  meta MetaAhorro @relation(fields: [metaId], references: [id], onDelete: Cascade)

  @@index([metaId])
  @@map("aportes_ahorro")
}

model GastoRecurrente {
  id Int @id @default(autoincrement())
  nombre String @db.VarChar(100)
  monto Decimal @db.Decimal(12, 2)
  metodoPago String? @db.VarChar(50) @map("metodo_pago")
  frecuencia String @db.VarChar(20)
  fechaInicio DateTime @db.Date @map("fecha_inicio")
  proximoVencimiento DateTime @db.Date @map("proximo_vencimiento")
  diasAviso Int @default(3) @map("dias_aviso")
  activo Boolean @default(true)
  usuarioId Int @map("usuario_id")
  categoriaId Int @map("categoria_id")
  creadoEn DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  categoria Categoria @relation(fields: [categoriaId], references: [id])
  movimientos Movimiento[]

  @@index([usuarioId, proximoVencimiento])
  @@map("gastos_recurrentes")
}
